[1.510747, "o", "\u001b[36m\u001b[1m============ 分段 1/4：退化输入可检出 ============\r\n\u001b(B\u001b[m"]
[1.51087, "o", "bash-5.2$ "]
[2.314248, "o", "grep -n 'GLM_VALIDATE_ZERO_VECTOR\\|GLM_VALIDATE_SINGULAR_MATRIX' include/cglm/validate.h | head -4\r\n"]
[2.317678, "o", "61:  GLM_VALIDATE_ZERO_VECTOR    = -1,\r\n63:  GLM_VALIDATE_SINGULAR_MATRIX = -2\r\n179: * @return GLM_VALIDATE_OK or GLM_VALIDATE_ZERO_VECTOR\r\n185:    return GLM_VALIDATE_ZERO_VECTOR;\r\n"]
[2.317919, "o", "bash-5.2$ "]
[3.521933, "o", "./build/tests 2>&1 | grep validate_\r\n"]
[3.602676, "o", "\u001b[32m  ✔\b✔︎\u001b[39m validate_zero_vector_detected            0\r\n\u001b[32m  ✔\b✔︎\u001b[39m validate_singular_matrix_detected        0\r\n\u001b[32m  ✔\b✔︎\u001b[39m validate_dest_untouched_on_failure       0\r\n\u001b[32m  ✔\b✔︎\u001b[39m validate_normal_input_bitexact           0\r\n"]
[3.606296, "o", "bash-5.2$ "]
[5.006888, "o", "\u001b[?7727h\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[1;1H\u001b[1;24r\u001b[13;11H\u001b[?25l\u001b[36m\u001b[1m\u001b[H============ 分段 1/4：退化输入可检出 ============\u001b(B\u001b[m\u001b[K\r\nbash-5.2$ grep -n 'GLM_VALIDATE_ZERO_VECTOR\\|GLM_VALIDATE_SINGULAR_MATRIX' include/cglm/validate.h | head -4\u001b[K\r\n61:  GLM_VALIDATE_ZERO_VECTOR    = -1,\u001b[K\r\n63:  GLM_VALIDATE_SINGULAR_MATRIX = -2\u001b[K\r\n179: * @return GLM_VALIDATE_OK or GLM_VALIDATE_ZERO_VECTOR\u001b[K\r\n185:    return GLM_VALIDATE_ZERO_VECTOR;\u001b[K\r\nbash-5.2$ ./build/tests 2>&1 | grep validate_\u001b[K\u001b[32m\r\n  ✔︎\u001b[39m validate_zero_vector_detected            0\u001b[K\u001b[32m\r\n  ✔︎\u001b[39m validate_singular_matrix_detected        0\u001b[K\u001b[32m\r\n  ✔︎\u001b[39m validate_dest_untouched_on_failure       0\u001b[K\u001b[32m\r\n  ✔︎\u001b[39m validate_normal_input_bitexact           0\u001b[K\r\nbash-5.2$ \u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[?12l\u001b[?25h\u001b[13;11H"]
